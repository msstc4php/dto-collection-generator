{
    "name": "msstc4php/dto-collection-generator",
    "description": "Generates natively typed collection classes over msstc4php/dto-collection from #[TypedCollection] attributes and a config file.",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": [
        "collection",
        "typed-collection",
        "dto",
        "code-generator"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../dto-collection",
            "options": {
                "symlink": false,
                "versions": {
                    "msstc4php/dto-collection": "1.1.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0",
        "composer-runtime-api": "^2.0",
        "msstc4php/dto-collection": "^1.1",
        "nikic/php-parser": "^5.1",
        "symfony/console": "^5.4.47 || ^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4.54 || ^6.4.45 || ^7.4.18 || ^8.1.6"
    },
    "require-dev": {
        "composer/composer": "^2.8",
        "doctrine/collections": "^2.2 || ^3.1",
        "doctrine/mongodb-odm": "^2.10",
        "phpunit/phpunit": "^10.5"
    },
    "bin": [
        "bin/dto-collection-generator"
    ],
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\DtoCollectionGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\DtoCollectionGenerator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "MSSTC4PHP\\DtoCollectionGenerator\\ComposerPlugin"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.31"
        },
        "platform-check": "php-only",
        "audit": {
            "abandoned": "report"
        }
    }
}
