parameters:
    # Every core makes a laptop unusable.
    parallel:
        maximumNumberOfProcesses: 4
    level: max
    phpVersion: 80100
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    bootstrapFiles:
        - vendor/autoload.php
    paths:
        - src/
        - tests/
    # Deliberately broken fixtures: the generator must report them, PHPStan cannot analyse them.
    excludePaths:
        analyseAndScan:
            - tests/Fixtures/Model/Broken.php
            - tests/Fixtures/Projects/Scan/
    disallowedFunctionCalls:
        -
            function:
                - 'var_dump()'
                - 'print_r()'
                - 'dump()'
                - 'dd()'
            message: 'debug artefact'
        -
            function:
                - 'memory_reset_peak_usage()'
                - 'ini_parse_quantity()'
                - 'mysqli_execute_query()'
                - 'openssl_cipher_key_length()'
                - 'libxml_get_external_entity_loader()'
                - 'json_validate()'
                - 'mb_str_pad()'
                - 'str_increment()'
                - 'str_decrement()'
                - 'array_find()'
                - 'array_find_key()'
                - 'array_any()'
                - 'array_all()'
                - 'mb_trim()'
                - 'mb_ltrim()'
                - 'mb_rtrim()'
                - 'mb_ucfirst()'
                - 'mb_lcfirst()'
                - 'fpow()'
                - 'http_get_last_response_headers()'
                - 'http_clear_last_response_headers()'
                - 'request_parse_body()'
                - 'grapheme_str_split()'
                - 'bcdivmod()'
                - 'array_first()'
                - 'array_last()'
                - 'get_error_handler()'
                - 'get_exception_handler()'
            message: 'PHP 8.2+ only; the generator runs on PHP 8.1 (phpVersion: 80100 does not catch functions present in the analysing runtime)'
    disallowedClasses:
        -
            class:
                - 'Random\Randomizer'
                - 'SensitiveParameter'
                - 'AllowDynamicProperties'
                - 'Override'
                - 'Deprecated'
                - 'DateMalformedStringException'
            message: 'PHP 8.2+ only; the generator runs on PHP 8.1'
